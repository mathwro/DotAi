{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dotai.local/stack.schema.json",
  "title": "DotAi stack manifest",
  "type": "object",
  "required": ["version", "packages", "skills", "marketplaces", "plugins", "mcp"],
  "additionalProperties": true,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 2},
    "prerequisites": {"type": "array", "items": {"$ref": "#/definitions/prerequisite"}},
    "integrationRequires": {
      "type": "object",
      "propertyNames": {"enum": ["packages", "skills", "marketplaces", "plugins", "ompExtensions", "ompRouting", "mcp"]},
      "additionalProperties": {"$ref": "#/definitions/requirements"}
    },
    "packages": {
      "type": "array",
      "items": {"$ref": "#/definitions/package"}
    },
    "skills": {
      "type": "array",
      "items": {"$ref": "#/definitions/skill"}
    },
    "marketplaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "requires": {"$ref": "#/definitions/requirements"},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9.-]+@[a-z0-9.-]+$"},
          "enabled": {"type": "boolean"},
          "requires": {"$ref": "#/definitions/requirements"},
          "scope": {"enum": ["user", "project"]}
        }
      }
    },
    "ompExtensions": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "required": ["path"], "properties": {
            "path": {"type": "string", "minLength": 1},
            "enabled": {"type": "boolean"},
            "requires": {"$ref": "#/definitions/requirements"}
          }, "additionalProperties": true}
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "ompRouting": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["providers", "primaryProvider"],
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["github-copilot", "openai-codex", "anthropic"]}
            },
            "primaryProvider": {"enum": ["github-copilot", "openai-codex", "anthropic"]},
            "agentModelOverrides": {
              "type": "object",
              "propertyNames": {"type": "string", "minLength": 1},
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "usageReservePct": {"type": "integer", "minimum": 0, "maximum": 100, "default": 10},
            "usageReservePolicy": {"enum": ["confirm", "auto", "fail-closed"], "default": "auto"},
            "fallbackRevertPolicy": {"enum": ["cooldown-expiry", "never"], "default": "cooldown-expiry"}
          }
        }
      ]
    },
    "mcp": {
      "type": "object",
      "required": ["target", "servers"],
      "additionalProperties": true,
      "properties": {
        "$schema": {"type": "string", "format": "uri"},
        "target": {"type": "string", "minLength": 1},
        "servers": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-zA-Z0-9_.-]{1,100}$"},
          "additionalProperties": {"$ref": "#/definitions/mcpServer"}
        }
      }
    }
  },
  "definitions": {
    "command": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "items": [{"type": "string", "minLength": 1}],
          "additionalItems": {"type": "string"}
        }
      ]
    },
    "commandList": {
      "type": "array",
      "items": {"$ref": "#/definitions/command"}
    },
    "platformValue": {
      "type": "object",
      "propertyNames": {"enum": ["windows", "wsl", "ubuntu", "arch", "macos", "linux", "unix", "default"]}
    },
    "platformCommands": {
      "oneOf": [
        {"$ref": "#/definitions/commandList"},
        {
          "allOf": [
            {"$ref": "#/definitions/platformValue"},
            {"additionalProperties": {"$ref": "#/definitions/commandList"}}
          ]
        }
      ]
    },
    "platformCheck": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "items": [{"type": "string", "minLength": 1}],
          "additionalItems": {"type": "string"},
          "minItems": 1
        },
        {
          "allOf": [
            {"$ref": "#/definitions/platformValue"},
            {
              "additionalProperties": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {
                    "type": "array",
                    "items": [{"type": "string", "minLength": 1}],
                    "additionalItems": {"type": "string"},
                    "minItems": 1
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "requirements": {
      "oneOf": [
        {"type": "array", "items": {"type": "string", "minLength": 1}},
        {"allOf": [
          {"$ref": "#/definitions/platformValue"},
          {"additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}}
        ]}
      ]
    },
    "prerequisite": {
      "type": "object",
      "required": ["name", "check"],
      "additionalProperties": true,
      "not": {"anyOf": [
        {"required": ["install"]}, {"required": ["update"]}, {"required": ["configure"]},
        {"required": ["uninstall"]}, {"required": ["pinInstall"]}, {"required": ["managed"]},
        {"required": ["recipe"]}, {"required": ["updateGroup"]}, {"required": ["version"]},
        {"required": ["updatePolicy"]}, {"required": ["requires"]}, {"required": ["provides"]},
        {"required": ["enabled"]}, {"required": ["updateRequires"]}
      ]},
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "check": {"$ref": "#/definitions/platformCheck"},
        "minimumVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"},
        "hint": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "required": ["name", "managed"],
      "anyOf": [{"required": ["recipe"]}, {"required": ["check", "install"]}],
      "not": {"required": ["updateGroup"]},
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "managed": {"const": true},
        "enabled": {"type": "boolean"},
        "recipe": {"type": "string", "minLength": 1},
        "requires": {"$ref": "#/definitions/requirements"},
        "provides": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "version": {"type": "string", "pattern": "^(latest|(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?)$"},
        "updatePolicy": {"enum": ["latest", "pinned"]},
        "uninstall": {"$ref": "#/definitions/platformCommands"},
        "pinInstall": {"$ref": "#/definitions/platformCommands"},
        "minimumVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"},
        "check": {"$ref": "#/definitions/platformCheck"},
        "install": {"$ref": "#/definitions/platformCommands"},
        "update": {"$ref": "#/definitions/platformCommands"},
        "configure": {"$ref": "#/definitions/platformCommands"}
      }
    },
    "skill": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": true,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "requires": {"$ref": "#/definitions/requirements"},
        "revision": {"type": "string", "minLength": 1},
        "installerVersion": {"type": "string", "minLength": 1},
        "updatePolicy": {"enum": ["latest", "pinned"]},
        "agent": {"type": "string", "default": "universal"},
        "skills": {"type": "array", "items": {"type": "string"}, "default": ["*"]},
        "checkSkills": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mcpServer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["command"],
          "properties": {
            "type": {"enum": ["stdio"]},
            "command": {"type": "string", "minLength": 1},
            "args": {"type": "array", "items": {"type": "string"}},
            "env": {"type": "object", "additionalProperties": {"type": "string"}},
            "cwd": {"type": "string"},
            "enabled": {"type": "boolean"},
            "timeout": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": {"enum": ["http", "sse"]},
            "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
            "headers": {"type": "object", "additionalProperties": {"type": "string"}},
            "enabled": {"type": "boolean"},
            "timeout": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
